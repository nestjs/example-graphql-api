NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:blog@localhost:5432/blog
# Signs the access tokens, at least 32 bytes. Generate with: openssl rand -base64 32
JWT_SECRET=

# The browser origins allowed to call the API, comma-separated. None by default.
# CORS_ORIGINS=http://localhost:5173

# NestJS Observe: `npx @nestjs/observe link` writes these. Empty, the SDK sends nothing.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
